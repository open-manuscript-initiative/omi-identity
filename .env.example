NODE_ENV=development
PORT=3010
DATABASE_URL=postgresql://omi_identity:change-me@127.0.0.1:5432/omi_identity
PUBLIC_ORIGIN=http://localhost:3010

# OIDC signing key. Generate with: npm run key:generate
OIDC_SIGNING_PRIVATE_KEY_B64=
OIDC_ID_TOKEN_TTL_SECONDS=600
OIDC_ACCESS_TOKEN_TTL_SECONDS=900
OIDC_AUTHORIZATION_CODE_TTL_SECONDS=300
IDENTITY_SESSION_TTL_HOURS=720

# ORCID upstream authentication. Leave blank until credentials are available.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_BASE_URL=https://orcid.org
ORCID_REDIRECT_URI=http://localhost:3010/auth/orcid/callback

# Optional administrative bootstrap token for future protected administration APIs.
ADMIN_BOOTSTRAP_TOKEN=
