generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalUserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum IdentityProvider {
  ORCID
  OIDC
  SAML
}

enum OidcClientType {
  PUBLIC
  CONFIDENTIAL
}

enum OidcClientStatus {
  ACTIVE
  DISABLED
}

model GlobalUser {
  id                String             @id @default(uuid()) @db.Uuid
  status            GlobalUserStatus   @default(ACTIVE)
  displayName       String?            @map("display_name") @db.VarChar(200)
  preferredLanguage String             @default("en") @map("preferred_language") @db.VarChar(16)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastLoginAt       DateTime?          @map("last_login_at") @db.Timestamptz(6)
  identities        GlobalIdentity[]
  emails            VerifiedEmail[]
  sessions          IdentitySession[]
  authorizationCodes AuthorizationCode[]
  accessTokens      AccessToken[]
  auditEvents       AuditEvent[]

  @@map("global_users")
}

model GlobalIdentity {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  provider    IdentityProvider
  issuer      String           @db.VarChar(512)
  subject     String           @db.VarChar(320)
  displayName String?          @map("display_name") @db.VarChar(200)
  profile     Json?            @db.JsonB
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastUsedAt  DateTime?        @map("last_used_at") @db.Timestamptz(6)
  user        GlobalUser       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, issuer, subject])
  @@index([userId, provider])
  @@map("global_identities")
}

model VerifiedEmail {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  email      String     @unique @db.VarChar(320)
  isPrimary  Boolean    @default(false) @map("is_primary")
  verifiedAt DateTime   @map("verified_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user       GlobalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isPrimary])
  @@map("verified_emails")
}

model OidcClient {
  id               String           @id @default(uuid()) @db.Uuid
  clientId         String           @unique @map("client_id") @db.VarChar(128)
  displayName      String           @map("display_name") @db.VarChar(200)
  clientType       OidcClientType   @default(CONFIDENTIAL) @map("client_type")
  clientSecretHash String?          @map("client_secret_hash") @db.VarChar(255)
  redirectUris     Json             @map("redirect_uris") @db.JsonB
  status           OidcClientStatus @default(ACTIVE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  authorizationCodes AuthorizationCode[]
  accessTokens     AccessToken[]

  @@index([status])
  @@map("oidc_clients")
}

model AuthorizationCode {
  id                  String     @id @default(uuid()) @db.Uuid
  codeHash            String     @unique @map("code_hash") @db.VarChar(64)
  userId              String     @map("user_id") @db.Uuid
  clientId            String     @map("client_id") @db.VarChar(128)
  redirectUri         String     @map("redirect_uri") @db.VarChar(2048)
  scope               String     @db.VarChar(512)
  nonce               String?    @db.VarChar(512)
  codeChallenge       String     @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String     @default("S256") @map("code_challenge_method") @db.VarChar(16)
  expiresAt           DateTime   @map("expires_at") @db.Timestamptz(6)
  usedAt              DateTime?  @map("used_at") @db.Timestamptz(6)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user                GlobalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  client              OidcClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([userId, expiresAt])
  @@map("authorization_codes")
}

model AccessToken {
  id        String     @id @default(uuid()) @db.Uuid
  tokenHash String     @unique @map("token_hash") @db.VarChar(64)
  userId    String     @map("user_id") @db.Uuid
  clientId  String     @map("client_id") @db.VarChar(128)
  scope     String     @db.VarChar(512)
  expiresAt DateTime   @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user      GlobalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    OidcClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([clientId, expiresAt])
  @@index([userId, expiresAt])
  @@map("access_tokens")
}

model IdentitySession {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  tokenHash String     @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime   @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  user      GlobalUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("identity_sessions")
}

model ProviderOAuthState {
  id         String           @id @default(uuid()) @db.Uuid
  stateHash  String           @unique @map("state_hash") @db.VarChar(64)
  provider   IdentityProvider
  returnUrl  String           @map("return_url") @db.VarChar(2048)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("provider_oauth_states")
}

model AuditEvent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String?     @map("user_id") @db.Uuid
  kind      String      @db.VarChar(128)
  data      Json?       @db.JsonB
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user      GlobalUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([kind, createdAt])
  @@map("audit_events")
}
